{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "phase",
  "side",
  "status",
  "evidence_sufficiency",
  "summary",
  "requirement_mapping",
  "design",
  "alternatives",
  "implementation_order",
  "validation",
  "risks",
  "assumptions",
  "evidence",
  "research",
  "exploration",
  "open_questions",
  "unverified"
 ],
 "properties": {
  "phase": {
   "type": "string",
   "enum": [
    "proposal"
   ]
  },
  "side": {
   "type": "string",
   "enum": [
    "codex",
    "claude"
   ]
  },
  "status": {
   "type": "string",
   "enum": [
    "COMPLETE",
    "INCOMPLETE"
   ]
  },
  "evidence_sufficiency": {
   "type": "string",
   "enum": [
    "sufficient",
    "partial",
    "insufficient"
   ]
  },
  "summary": {
   "type": "string"
  },
  "requirement_mapping": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "requirement",
     "approach"
    ],
    "properties": {
     "requirement": {
      "type": "string"
     },
     "approach": {
      "type": "string"
     }
    }
   }
  },
  "design": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "components",
    "flows",
    "contracts"
   ],
   "properties": {
    "components": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "flows": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "contracts": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "alternatives": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "option",
     "reason_rejected"
    ],
    "properties": {
     "option": {
      "type": "string"
     },
     "reason_rejected": {
      "type": "string"
     }
    }
   }
  },
  "implementation_order": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "validation": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "check",
     "layer"
    ],
    "properties": {
     "check": {
      "type": "string"
     },
     "layer": {
      "type": "string",
      "enum": [
       "local",
       "mock",
       "user-real"
      ]
     }
    }
   }
  },
  "risks": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "severity",
     "risk",
     "mitigation"
    ],
    "properties": {
     "severity": {
      "type": "string",
      "enum": [
       "high",
       "medium",
       "low"
      ]
     },
     "risk": {
      "type": "string"
     },
     "mitigation": {
      "type": "string"
     }
    }
   }
  },
  "assumptions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "evidence": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "kind",
     "ref",
     "observation"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "kind": {
      "type": "string",
      "enum": [
       "file",
       "command",
       "mcp",
       "web",
       "brief",
       "inference"
      ]
     },
     "ref": {
      "type": "string"
     },
     "observation": {
      "type": "string"
     }
    }
   }
  },
  "research": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "question_date",
    "web_used",
    "trends",
    "common_practices",
    "papers",
    "not_applicable_reason"
   ],
   "properties": {
    "question_date": {
     "type": "string"
    },
    "web_used": {
     "type": "boolean"
    },
    "trends": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "summary",
       "url"
      ],
      "properties": {
       "summary": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      }
     }
    },
    "common_practices": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "summary",
       "url"
      ],
      "properties": {
       "summary": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      }
     }
    },
    "papers": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "title",
       "url",
       "year",
       "relevance"
      ],
      "properties": {
       "title": {
        "type": "string"
       },
       "url": {
        "type": "string"
       },
       "year": {
        "type": "string"
       },
       "relevance": {
        "type": "string"
       }
      }
     }
    },
    "not_applicable_reason": {
     "type": "string"
    }
   }
  },
  "exploration": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "applicable",
    "not_applicable_reason",
    "target_architecture",
    "candidates",
    "chosen",
    "current_gap",
    "migration_path",
    "compromises"
   ],
   "properties": {
    "applicable": {
     "type": "boolean"
    },
    "not_applicable_reason": {
     "type": "string"
    },
    "target_architecture": {
     "type": "string"
    },
    "candidates": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "name",
       "approach",
       "tradeoffs",
       "basis"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "approach": {
        "type": "string"
       },
       "tradeoffs": {
        "type": "string"
       },
       "basis": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     }
    },
    "chosen": {
     "type": "string"
    },
    "current_gap": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "migration_path": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "compromises": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "open_questions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "unverified": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 }
}
