#!/bin/sh
# git pull（merge・fast-forward）後、設置関連ファイルが変わっていたら知らせるだけの hook。
# Python・install.py・tools/harness_setup.py は実行しない（利用者決定: 通知のみ）。
# 利用者が端末で実行する dry-run・適用コマンドを絶対パスで案内する。失敗しても merge 結果には影響しない。
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0
git rev-parse -q --verify ORIG_HEAD >/dev/null 2>&1 || exit 0
[ "$(git rev-parse ORIG_HEAD)" != "$(git rev-parse HEAD)" ] || exit 0

changed=$(git diff --name-only ORIG_HEAD HEAD -- hooks install settings instructions skills agents tools/aws 2>/dev/null) || exit 0
[ -n "$changed" ] || exit 0

echo
echo "[ai-harness] 설치본에 반영이 필요한 파일이 바뀌었습니다(이 hook은 아무것도 실행하지 않습니다):"
printf '%s\n' "$changed" | sed 's/^/  /'

if [ ! -f config.local.json ]; then
    echo "config.local.json 이 없습니다. 이 컴퓨터에서 처음이면 터미널에서 ./setup.sh 를 실행하세요."
    exit 0
fi
# aws 節が見本の値（例示アカウント ID）のままなら、適用コマンドではなく編集を案内する
if grep -qF 'iam::123456789012:' config.local.json 2>/dev/null; then
    echo "config.local.json 의 aws.roles 또는 aws.mfa_serial 이 아직 견본 값입니다. 실제 값으로 편집한 뒤 ./setup.sh 를 다시 실행하세요."
    exit 0
fi

# 単一引用符で囲んで表示する（パスに空白・引用符があってもそのまま貼り付けられるように）
quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}
install=$(quote "$root/install/install.py")
config=$(quote "$root/config.local.json")
echo "반영하려면 터미널에서 직접 실행하세요(<python>은 config.local.json의 python 값, null이면 venv가 아닌 python3):"
# パスを含む行は printf '%s\n' で出す（dash の echo は \ を解釈するため）
printf '%s\n' "  확인(dry-run): <python> $install --config $config"
printf '%s\n' "  적용:          <python> $install --config $config --apply   (확인 문구에 apply 입력)"
echo "  AWS 모듈을 쓰는 경우 두 명령 모두 --with-aws 를 붙입니다."
exit 0
